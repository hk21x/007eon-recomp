# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe     # the on-foot game; driving.xbe (the driving levels) is the EoNDriving target
GAME_LOG=eon             # GameInfo::log
GAME_TARGET=EoN          # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=eon
SMOKE_PAD=scripts/pad/explore.txt  # the first boot: movies, then the training level; cover, lock on, fire
SMOKE_MENU="900 1500"   # the THX and MGM movies: one draw a frame (the "menu" check: a 2D phase before the level)
SOAK_PAD=scripts/soak_pad.sh  # the level, Quit, New Game, Ground Zero, over and over
